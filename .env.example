# ─────────────────────────────────────────────────────────────
# wGlobe — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# EXPO_PUBLIC_ önekli değişkenler istemci paketine gömülür:
# buraya ASLA service_role anahtarı koymayın.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Radio Browser ana sunucusu (boş bırakılırsa de1 kullanılır, ardından aynalara düşülür)
EXPO_PUBLIC_RADIO_BROWSER_BASE=https://de1.api.radio-browser.info

# Open-Meteo uç noktası (anahtar gerektirmez)
EXPO_PUBLIC_OPEN_METEO_BASE=https://api.open-meteo.com
